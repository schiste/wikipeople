# Local development. On Toolforge, injected TOOL_TOOLSDB_* credentials are used automatically.
DATABASE_URL=sqlite:///./wikipeople.db
# Optional Toolforge override; defaults to ${TOOL_TOOLSDB_USER}__wikipeople.
# TOOLSDB_DATABASE=s12345__wikipeople
WIKIPEOPLE_USER_AGENT=WikiPeople/0.1 (https://github.com/schiste/wikifame; contact@example.org)
ALGORITHM_VERSION=attribution-ladder-v3
# Wikis served on demand. "*" means every WikiWho-covered Wikipedia; a comma-separated list of
# database names narrows that. A wiki WikiWho cannot analyse is never served, listed or not.
SUPPORTED_WIKIS=*
# Wikis whose daily top-1000 is kept warm before anyone asks. Wikis that produce a real result are
# added automatically, so this is only for pinning a wiki ahead of its first reader.
PREWARM_WIKIS=frwiki
# Wikis crawled article by article. Never inferred: bulk crawling is a capacity commitment.
BACKFILL_WIKIS=
# Override WikiWho language coverage without a code release. Empty means the built-in set.
# WIKIWHO_LANGUAGES=fr,en,de
# Browser origins allowed to call the API. The regex covers every Wikipedia, desktop and mobile;
# CORS_ORIGINS adds exact origins on top of it. Neither is authentication.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.(?:m\.)?wikipedia\.org$
WIKIWHO_BASE_URL=https://wikiwho-api.wmcloud.org
REQUEST_TIMEOUT_SECONDS=20
WIKIWHO_TIMEOUT_SECONDS=90
WIKIWHO_MAX_RESPONSE_BYTES=33554432
CANDIDATE_POOL_SIZE=50
MINIMUM_TOKENS=20
MINIMUM_SHARE=0.01
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=8
DEAD_RETRY_SECONDS=86400
# Three different clocks. How long a stored answer stays usable is 90 days; how long a browser may
# reuse one without revalidating is 5 minutes, because that is the delay between deploying a policy
# change and readers seeing it; how long a stale copy may be shown while a fresh one is fetched is
# 7 days. Every response carries an ETag, so a lapsed window normally costs a 304 with no body.
READY_CACHE_SECONDS=300
PAGE_FRESHNESS_SECONDS=7776000
PAGE_CACHE_SECONDS=300
PAGE_STALE_WHILE_REVALIDATE_SECONDS=604800
# The on-wiki list of articles counted but not named. "Project:" resolves to each wiki's own
# project namespace, so one title works everywhere. Categories are covered one level deep only.
OPTOUT_PAGE=Project:WikiPeople/opt-out
OPTOUT_CATEGORY_LIMIT=5000
# The on-wiki page a community states its display policy on: whether contributors are named at
# all, and how a sanctioned or a renamed account appears. Ordinary wikitext, never a .json
# subpage — MediaWiki locks those to interface administrators, and who gets named is not an
# interface administrator's decision. A wiki with no page is served the defaults. See ADR-0011.
DISPLAY_POLICY_PAGE=Project:WikiPeople/display
METHODOLOGY_URL=https://github.com/schiste/wikifame/blob/main/docs/architecture.md
# Whether an account the wiki has lastingly excluded is dropped from the names. The line is drawn
# by duration: an indefinite block or a CentralAuth lock withholds the name, a fortnight's block
# does not. Applied when the response is built, so a change takes effect in minutes and reverses
# just as fast. Equal by coincidence to PAGE_FRESHNESS_SECONDS above and unrelated to it.
HIDE_SANCTIONED_CONTRIBUTORS=true
MAX_VISIBLE_BLOCK_SECONDS=7776000
# Per-wiki overrides, "frwiki:2592000,enwiki:0". 0 withholds any actively blocked account's name.
MAX_VISIBLE_BLOCK_SECONDS_BY_WIKI=
# CentralAuth answers about one account per request, so lock checks are rationed and rotate.
STANDING_LOCK_CHECKS_PER_RUN=500
STANDING_LOCK_RECHECK_SECONDS=86400

# Ranking what to compute next by what people actually read. The daily job streams one published
# pageview_complete file (640 MB, about two and a half minutes) and keeps the top pages per wiki,
# for BACKFILL_WIKIS entries only — ranking what to crawl is crawling. The minimum is a memory
# bound, not a threshold of merit: a large Wikipedia has over a million pages opened at least once
# in a day and holding all of them costs more than a Toolforge job is given. See ADR-0010.
PAGEVIEW_DUMP_ROOT=/public/dumps/public/other/pageview_complete
PAGEVIEW_LOOKBACK_DAYS=5
PAGEVIEW_MINIMUM_VIEWS=5
DEMAND_TOP_PAGES=50000
# Re-checking the articles this tool's own readers opened. A page somebody opened is the one
# likeliest to be opened again, so it is compared against its current revision weekly rather than
# quarterly — and no sooner, or one heavily edited article takes the whole budget.
REQUESTED_PREWARM_DAYS=30
REQUESTED_PREWARM_LIMIT=2000
REQUESTED_RECOMPUTE_SECONDS=604800
# Retrying answers that had to fall back to counting edits, in case WikiWho has indexed the
# revision since. Self-limiting: a retry that lands on the same rung refreshes the row's date and
# drops back out of the sweep until the minimum age passes again.
RECOMPUTE_BATCH_SIZE=200
RECOMPUTE_MIN_AGE_SECONDS=1209600
